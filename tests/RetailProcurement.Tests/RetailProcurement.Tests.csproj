<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Required to access ASP.NET Core types (MVC, SignalR, Authorization) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

  <!--
    Compile API controllers and hub directly into the test assembly.
    This avoids loading RetailProcurement.API.dll (built with Microsoft.NET.Sdk.Web)
    which Windows AppLocker blocks when loaded dynamically by the test runner.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\RetailProcurement.API\Controllers\StoreItemsController.cs" />
    <Compile Include="..\..\src\RetailProcurement.API\Controllers\SuppliersController.cs" />
    <Compile Include="..\..\src\RetailProcurement.API\Controllers\StatisticsController.cs" />
    <Compile Include="..\..\src\RetailProcurement.API\Controllers\SupplierStoreItemsController.cs" />
    <Compile Include="..\..\src\RetailProcurement.API\Controllers\AuthController.cs" />
    <Compile Include="..\..\src\RetailProcurement.API\Hubs\ProcurementHub.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RetailProcurement.Core\RetailProcurement.Core.csproj" />
    <ProjectReference Include="..\..\src\RetailProcurement.Infrastructure\RetailProcurement.Infrastructure.csproj" />
  </ItemGroup>

</Project>
